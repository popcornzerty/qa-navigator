# SQLite is the default for local development. Use PostgreSQL later for a shared deployment.
DATABASE_URL=sqlite:///./qa_engine.db
API_V1_PREFIX=/api/v1

# Comma-separated origins allowed to call the engine. The frontend dev server uses 8080.
# Read at startup only: restart the service after changing this.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Absolute paths containing repositories the service may inspect. Empty allows any readable local path.
ALLOWED_REPOSITORY_ROOTS=

# Local generation runtime. Nothing leaves this machine: no API key, no remote provider.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=900
GENERATION_LANGUAGE=fr

# Working directory for cloned repositories and generated artifacts.
WORK_DIRECTORY=work

# Generation is the slowest step (see README: throughput depends on CPU vs GPU).
# 0 generates for every detected feature; a small value keeps an analysis bounded.
GENERATION_ENABLED=true
GENERATION_MAX_FEATURES=3

# Jira Cloud, read-only. Create a token at:
# https://id.atlassian.com/manage-profile/security/api-tokens
# Credentials stay server-side and are never returned by the API.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Jira has no standard acceptance-criteria field. If your team uses one, put its id here.
JIRA_ACCEPTANCE_CRITERIA_FIELD=
