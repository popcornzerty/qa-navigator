# Copy this file to `.env` (same folder). The engine reads it at startup only:
# restart the engine after any change.

# Where the engine stores its data. Leave commented to use `backend/qa_engine.db`.
# A relative SQLite path is resolved against `backend/`, never against the directory the
# engine happens to be started from. Use PostgreSQL for a shared deployment.
# DATABASE_URL=sqlite:///qa_engine.db
API_V1_PREFIX=/api/v1

# Comma-separated origins allowed to call the engine. The frontend dev server uses 8080.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Absolute paths containing repositories the service may inspect. Empty allows any readable local path.
ALLOWED_REPOSITORY_ROOTS=

# Generation of User Story, Gherkin and Playwright proposals (optional).
# Off by default: analyses stay fast and never touch the backlog. Proposals can still be
# requested from the interface, on one domain, story or scenario at a time.
GENERATION_ENABLED=false
GENERATION_LANGUAGE=fr
# 0 generates for every detected feature; a small value keeps an analysis bounded.
GENERATION_MAX_FEATURES=3

# Which model writes the proposals:
#   ollama — runs on this machine. Nothing leaves it.
#   openai — any OpenAI-compatible API (Meta Model API, OpenRouter, OpenCode Zen, vLLM…).
#            PROMPTS LEAVE THIS MACHINE: excerpts of the analysed source, the labels and
#            copy of its screens, its routes and the requirements being written. Free and
#            "contributor" offers may keep them to train their models.
GENERATION_PROVIDER=ollama

# Used when GENERATION_PROVIDER=ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=900

# Used when GENERATION_PROVIDER=openai. Example, Muse Spark 1.3 through OpenCode Zen (free
# for a limited time, in exchange for Meta using prompts and answers for training):
#   GENERATION_BASE_URL=https://opencode.ai/zen/v1
#   GENERATION_MODEL=muse-spark-1.3-contributor-free
GENERATION_BASE_URL=
GENERATION_MODEL=
# Never shown by the API, never logged, never passed to the tested project.
GENERATION_API_KEY=
GENERATION_TIMEOUT_SECONDS=300

# Clones of GitHub repositories and generated artifacts. A relative path is resolved
# against `backend/`. On Windows, keep the engine in a short path: git fails beyond 260
# characters.
WORK_DIRECTORY=work

# Jira Cloud, read-only. Create a token at:
# https://id.atlassian.com/manage-profile/security/api-tokens
# Credentials stay server-side and are never returned by the API.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Jira has no standard acceptance-criteria field. If your team uses one, put its id here.
JIRA_ACCEPTANCE_CRITERIA_FIELD=

# Variables needed by the TESTED project's own Playwright suite — typically the account a
# login setup signs in with. Every other variable in this file is passed to the Playwright
# process the engine starts; the engine's own settings above (Jira token, generation key…)
# never are. None is returned by the API or written to a log (only their names are). Use
# the names your suite reads, for example:
# MY_APP_E2E_USER=
# MY_APP_E2E_PASSWORD=
